from chatbot import ChatBot
from logger import Logger


def main():

    bot = ChatBot()

    logger1 = Logger()
    logger2 = Logger()

    print("Singleton Demonstration:")
    print(logger1 is logger2)
    print()

    print("Type 'exit' to quit.")

    while True:

        user = input("You: ")

        if user.lower() == "exit":
            print("Bot: Goodbye!")
            break

        print("Bot:", bot.get_response(user))


if __name__ == "__main__":
    main()
