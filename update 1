from logger import Logger
from factory import ResponseFactory


class ChatBot:

    def __init__(self):
        # Get the single Logger instance (Singleton)
        self.logger = Logger()

    def get_response(self, user_input):
        # Log the user's input
        self.logger.log(user_input)

        # Use the Factory Method to create the appropriate responder
        responder = ResponseFactory.create(user_input)

        # Return the response generated by the responder
        return responder.respond()
